	$(document).on('click', '#main-header .site-main-header-dropdown .panel-container-1 ul a, #main-header .site-main-header-dropdown .panel-container-2 ul a', function(e) {
		var li = $(this).closest('li');
		if(li.hasClass('menu-item-has-children') && !li.hasClass('active')) {
			e.preventDefault();
			var ul = $(this).closest('ul');
			$('li.menu-item.active', ul).removeClass('active');
			li.addClass('active');

			var headerDropdown = $('#main-header .site-main-header-dropdown');
			var panel = $('<div class="panel"></div>');
			panel.append('<h3><a>' + $('.nav-drop-title-wrap', this).html() + '</a></h3>');
			if($(this).attr('href') && $(this).attr('href') != '') {
				$('> h3 > a', panel).attr('href', $(this).attr('href'));
			}
			panel.append($('> .sub-menu', li).clone());
			
			var panelContainer = ul.closest('.panel-container').next('.panel-container');
			panelContainer.append(panel);
			panelContainer.addClass('active');
			panelContainer.nextAll('.panel-container').removeClass('active');

			headerDropdown.removeClass('panels-active-1 panels-active-2 panels-active-3');
			headerDropdown.addClass('panels-active-' + $('.panel-container.active', headerDropdown).length);

			$('.panel.active', panelContainer).each(function(i, el) {
				$(el).removeClass('active');
			});
			panel.addClass('active');

			setTimeout(function() {
				$(document).trigger('resizeHeaderDropdown');
			}, 1);
			setTimeout(function() {
				$('.panel:not(.active)', headerDropdown).remove();
			}, 500);
		}
	});
	$(document).on('resizeHeaderDropdown', function(e) {
		var activeMenuItem = $('#main-header .main-navigation .primary-menu-container > ul > li.menu-item.active');
		if(!activeMenuItem.length) return;
		var headerDropdown = $('#main-header .site-main-header-dropdown');
		var panelWidth = $('#main-header .site-main-header-inner-wrap').width() / 3;
		var panelsActiveCount = 1;
		if($('.panel-container-2.active', headerDropdown).length) panelsActiveCount++;
		if($('.panel-container-3.active', headerDropdown).length) panelsActiveCount++;
		var headerDropdownWidth = panelWidth * panelsActiveCount;
		var activeMenuItemOffset = activeMenuItem.offset().left + (activeMenuItem.outerWidth() / 2) - $('.site-main-header-inner-wrap').offset().left;
		var headerDropdownOffset = Math.max(0, activeMenuItemOffset - (headerDropdownWidth / 2));
		var headerDropdownOverflow = Math.max(0, headerDropdownOffset + headerDropdownWidth - $('#main-header .site-main-header-inner-wrap').width());
		headerDropdownOffset -= headerDropdownOverflow;
		var caretOffset = activeMenuItemOffset - headerDropdownOffset;
		headerDropdown.css({
			'--panel-width': panelWidth + 'px',
			'--offset': headerDropdownOffset + 'px',
			'--caret-offset': caretOffset + 'px'
		});
		var panelHeight = 0;
		$('.panel.active', headerDropdown).each(function() {
			panelHeight = Math.max(panelHeight, $(this).outerHeight());
		});
		headerDropdown.css({
			'--panel-height': panelHeight + 'px',
		});
	});
	$(window).on('resize', function() { $(document).trigger('resizeHeaderDropdown'); });


	var lastScrollPosition = 0;
	var updateHeaderStyle = function() {
		var miniHeaderHeight = 46;
		var hiddenHeaderHeight = 500;
		var scrollPosition = $(window).scrollTop();
		if(scrollPosition > miniHeaderHeight && lastScrollPosition <= miniHeaderHeight) {
			$('body').addClass('mini-site-header');
		} else if(scrollPosition <= miniHeaderHeight && lastScrollPosition > miniHeaderHeight) {
			$('body').removeClass('mini-site-header');
		}
		if(scrollPosition < lastScrollPosition) {
			$('body').removeClass('hidden-site-header');
		} else if(scrollPosition > hiddenHeaderHeight) {
			$('body').addClass('hidden-site-header');
			$(document).trigger('click');
		} 
		lastScrollPosition = scrollPosition;
	};
	$(window).on('scroll', updateHeaderStyle);
	$(document).on('ready', updateHeaderStyle);


