	var updateAtmosphereElements = function() {
		var bodyLayerContainer = $('#atmosphere-bg');
		if(!bodyLayerContainer.length) {
			bodyLayerContainer = $('<div id="atmosphere-bg"></div>');
			$('#wrapper').prepend(bodyLayerContainer);
		}
		$('.kbt-atmosphere-bg:not(.no-proxy) .layer').each(function(i, el) {
			var layer = $(el);
			var layerProxy = layer.data('layer-proxy');
			if(!layerProxy) {
				layerProxy = layer.clone();
				layer.data('layer-proxy', layerProxy);
				bodyLayerContainer.append(layerProxy);
			}
			var css = {
				width: layer.width(),
				height: layer.height(),
				left: layer.offset().left,
				top: layer.offset().top,
				display: 'block'
			};
			if(!layer.offset().top) {
				css.display = 'none';
			}
			layerProxy.css(css);
		});
	};
	$(document).on('ready', updateAtmosphereElements);
	$(window).on('load', updateAtmosphereElements);
	$(window).on('resize', updateAtmosphereElements);


