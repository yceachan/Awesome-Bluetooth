	$(document).on('click', '#main-header .main-navigation .primary-menu-container > ul > li.menu-item', function(e) {
		var li = $(this);
		var link = $('> a', this);
		if(li.hasClass('menu-item-has-children') && !li.hasClass('active')) {
			e.preventDefault();
			$('.main-navigation .primary-menu-container > ul > li.menu-item.active').removeClass('active');
			li.addClass('active');

			var headerDropdown = $('#main-header .site-main-header-dropdown');
			var panel = $('<div class="panel"></div>');
			panel.append('<h3><a>' + $('.nav-drop-title-wrap', link).html() + '</a></h3>');
			if($(link).attr('href') && $(link).attr('href') != '') {
				$('> h3 > a', panel).attr('href', $(link).attr('href'));
			}
			panel.append($('> .sub-menu', li).clone());
			$('.panel-container-1', headerDropdown).append(panel);

			$('.panel-container-2.active, .panel-container-3.active', headerDropdown).removeClass('active');

			headerDropdown.removeClass('panels-active-1 panels-active-2 panels-active-3');
			headerDropdown.addClass('panels-active-' + $('.panel-container.active', headerDropdown).length);

			$('.panel.active', headerDropdown).each(function(i, el) {
				$(el).removeClass('active');
			});
			panel.addClass('active');

			$(document).trigger('resizeHeaderDropdown');
			setTimeout(function() {
				$('body').addClass('main-navigation-open');
			}, 0);
			setTimeout(function() {
				$(document).trigger('resizeHeaderDropdown');
			}, 1);
			setTimeout(function() {
				$('.panel:not(.active)', headerDropdown).remove();
			}, 500);
		}
	});
